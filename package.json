{
  "name": "neon-squadron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEON SQUADRON - a 2.5D neon roguelike squadron shooter for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tools/browser/smoke.mjs",
    "shots": "node tools/browser/shot.mjs"
  },
  "dependencies": {
    "playcanvas": "^2.23.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
